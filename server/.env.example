# 北牖后端环境变量
PORT=3090
JWT_SECRET=change_me_in_production

# 玄剑官网 OAuth（对接 www.xuanjian.top）
OAUTH_PROVIDER_URL=https://www.xuanjian.top
# client_id 由玄剑官网注册分配（北牖自定为 northbooker）
OAUTH_CLIENT_ID=northbooker
# client_secret 由玄剑官网注册分配，生产环境务必填写
OAUTH_CLIENT_SECRET=
# redirect_uri 必须与玄剑官网注册一致，指向后端的 /api/auth/callback
# 生产：https://northbooker.xuanjian.top/api/auth/callback
# 开发：http://localhost:5173/api/auth/callback
OAUTH_REDIRECT_URI=https://northbooker.xuanjian.top/api/auth/callback

# 七牛对象存储（东南亚 as0 区域）
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=northbooker
QINIU_CDN_DOMAIN=http://cdn.northbooker.xuanjian.top
