# ===== 前端环境变量（Vite，需 VITE_ 前缀）=====

# 后端 API 基础地址（开发态走 Vite 代理到 localhost:3000）
VITE_API_BASE_URL=/api

# 注意：OAuth client_id / client_secret / redirect_uri 等敏感配置
# 均放在 server/.env，由后端统一处理，前端只需调用 /api/auth/login 跳转。

# ===== 后端环境变量（在 server/.env，此处仅作参考）=====
# OAUTH_PROVIDER_URL=https://www.xuanjian.top
# OAUTH_CLIENT_ID=northbooker
# OAUTH_CLIENT_SECRET=
# OAUTH_REDIRECT_URI=https://northbooker.xuanjian.top/api/auth/callback
# JWT_SECRET=
# PORT=3000
