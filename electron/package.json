{
  "name": "northbooker-desktop",
  "version": "2.5.1",
  "description": "北牖 NorthBooker 桌面版 - 云端文档查看与在线协作",
  "author": "北域工作室 <morzane_work@foxmail.com>",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron . --dev",
    "build": "electron-builder"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.3.9",
    "sherpa-onnx-node": "^1.13.4",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "electron": "^31.4.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "top.xuanjian.northbooker",
    "productName": "北牖 NorthBooker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "tts.js",
      "tts-worker.js",
      "renderer-dist/",
      "icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "tts-worker.js",
      "node_modules/sherpa-onnx-node/**",
      "node_modules/sherpa-onnx-win-x64/**",
      "node_modules/sherpa-onnx-win-ia32/**"
    ],
    "extraResources": [
      {
        "from": "node-runtime/node.exe",
        "to": "node/node.exe"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "northland-studio",
      "repo": "NorthBooker"
    },
    "artifactName": "${name}-${version}.${ext}",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "icon.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "icon.png",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${name}-setup-${version}.${ext}"
    }
  }
}
